# SLQS KSA — Gmail SMTP, safe template. Copy values into your existing .env.
# DO NOT COMMIT .env OR SHARE A REAL GMAIL APP PASSWORD.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=REPLACE_WITH_YOUR_GENERATED_DJANGO_SECRET_KEY
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_BASE_URL=http://127.0.0.1:8000
DB_ENGINE=sqlite

# Only ONE EMAIL_BACKEND entry should exist in the actual .env
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_GMAIL_ADDRESS@gmail.com
EMAIL_HOST_PASSWORD=PASTE_YOUR_NEW_GOOGLE_APP_PASSWORD_HERE
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL="SLQS KSA <YOUR_GMAIL_ADDRESS@gmail.com>"

# Optional notifications. Replace each with a valid email address.
MEMBERSHIP_ADMIN_EMAIL=YOUR_GMAIL_ADDRESS@gmail.com
EVENTS_ADMIN_EMAIL=YOUR_GMAIL_ADDRESS@gmail.com
CONTACT_INBOX_EMAIL=YOUR_GMAIL_ADDRESS@gmail.com
